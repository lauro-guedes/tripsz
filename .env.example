# Copie este arquivo para ".env.local" e preencha. NUNCA suba o .env.local para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de servidor: dá acesso total ao banco. Nunca use no navegador nem com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (use as credenciais de TESTE até validar o fluxo) ---
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- API-Football (api-sports.io): jogos, times e estádios. Só é usada no servidor. ---
FOOTBALL_API_KEY=

# --- Acessos especiais (e-mails separados por vírgula) ---
# Quem pode abrir o painel /admin
ADMIN_EMAILS=voce@exemplo.com
# Quem usa o Passport sem pagar
NEXT_PUBLIC_FREE_ACCESS_EMAILS=

# --- Endereço do site (sem barra no final). Local: http://localhost:3000 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
